# Telegram Bot Token from @BotFather
BOT_TOKEN="your_telegram_bot_token_here"

# Google Spreadsheet ID (found between /d/ and /edit in the Google Sheets URL)
SPREADSHEET_ID="your_google_spreadsheet_id_here"

# Path to Google Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE="credentials.json"

# Telegram numeric user/chat ID(s) for admins (comma-separated for multiple)
ADMIN_CHAT_ID="123456789"

# Optional: Telegram Mini App URL shown as an "Open" button on /start
WEBAPP_URL=""
